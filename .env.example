# ── LLM providers ───────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ── MongoDB ─────────────────────────────────────
MONGO_URL=
DB_NAME=

# ── Frontend (CORS + default Clerk authorized party) ──
FRONTEND_URL=http://localhost:3000

# ── Clerk authentication ────────────────────────
# Server-only secret. Never put this in a NEXT_PUBLIC_ variable.
CLERK_SECRET_KEY=
# Public key; used to work out CLERK_ISSUER when that is not set.
CLERK_PUBLISHABLE_KEY=
# Optional: your Clerk Frontend API URL (token "iss"), e.g. https://xxx.clerk.accounts.dev
CLERK_ISSUER=
# Optional: comma-separated frontend origins allowed to use tokens (token "azp"). Defaults to FRONTEND_URL.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Optional: PEM public key (Clerk Dashboard -> API Keys) for fully offline verification.
CLERK_JWT_KEY=
